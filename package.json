{
  "name": "boilerplate-pnpm-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "UNLICENSED",
  "author": "shota-kamezawa",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "format": "oxfmt",
    "lint:css": "stylelint \"**/*.{css,scss}\" --ignore-path .gitignore",
    "lint:format": "oxfmt --check",
    "lint:js": "oxlint",
    "lint:licenses": "node ./scripts/check-licenses.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "oxlint-tsgolint": "0.23.0",
    "stylelint": "17.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.6.0",
      "onFail": "error"
